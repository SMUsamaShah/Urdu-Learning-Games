{
  "name": "urdu-learning-games",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Free, open source, ad-free Urdu learning games for young children",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "bake": "node tools/bake-glyphs.mjs",
    "audio:manifest": "node tools/build-audio-manifest.mjs",
    "record": "node tools/record-studio/server.mjs",
    "verify:studio": "node tools/verify-studio.mjs",
    "verify:audio": "node tools/verify-audio.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "strokes": "vite --config tools/stroke-editor/vite.config.js"
  },
  "dependencies": {
    "@fontsource/noto-nastaliq-urdu": "^5.3.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "harfbuzzjs": "^1.6.0",
    "opentype.js": "^2.0.0",
    "playwright": "^1.62.1",
    "vite": "^8.2.1",
    "wawoff2": "^2.0.1"
  }
}
