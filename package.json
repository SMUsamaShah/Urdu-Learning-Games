{
  "name": "urdu-learning-games",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Free, open source, ad-free Urdu learning games for young children",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
