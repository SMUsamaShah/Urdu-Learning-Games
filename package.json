    "images": "node tools/make-word-images.mjs",
    "mascot": "node tools/make-mascot.mjs",
    "audio:manifest": "node tools/build-audio-manifest.mjs",
    "record": "node tools/record-studio/server.mjs",
    "verify:studio": "node tools/verify-studio.mjs",
    "verify:polish": "node tools/verify-take-polish.mjs",
    "verify:audio": "node tools/verify-audio.mjs",
    "verify:offline": "node tools/verify-offline.mjs",
    "verify:recording": "node tools/verify-recording.mjs",
    "verify:games": "node tools/verify-games.mjs",
    "verify:trace": "node tools/verify-trace.mjs",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "dependencies": {
    "@fontsource/noto-nastaliq-urdu": "^5.3.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "harfbuzzjs": "^1.6.0",
    "playwright": "^1.62.1",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "wawoff2": "^2.0.1"
